# Base URL of the backend API (without trailing slash)
# Example: https://your-backend-api.onrender.com or http://localhost:5000
VITE_API_BASE_URL=https://mannat-backend.onrender.com

# Razorpay Key ID (From Razorpay Dashboard -> Settings -> API Keys)
# Use your Test Key ID for development & testing (e.g. rzp_test_xxxxxxxxxx)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyHere
